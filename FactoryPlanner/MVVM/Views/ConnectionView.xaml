<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FactoryPlanner.MVVM.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FactoryPlanner.MVVM.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Canvas x:Name="RootCanvas">
        <Path x:Name="ConnectionPath"
              Stroke="{ThemeResource TextFillColorPrimaryBrush}"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeThickness="2" />

        <TextBox x:Name="MidpointTextBox"
                 Text="{Binding Input.PortIndex, Mode=OneWay}"
                 MinWidth="0"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Canvas>
</UserControl>
