<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FactoryPlanner.MVVM.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FactoryPlanner.MVVM.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:FactoryPlanner.Core.MVVM.Models.ViewModels"
             mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
            CornerRadius="16">
        <Grid Margin="8"
              ColumnSpacing="8"
              RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <Grid Grid.ColumnSpan="2"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Name" />
                <TextBlock Text="Made In:"
                           Grid.Column="1"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding AllMachines}"
                          SelectedItem="{Binding Machine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedIndex="0"
                          Grid.Column="2"
                          DisplayMemberPath="Name" />
            </Grid>

            <TextBox Text="{Binding CraftTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Craft Duration (s)"
                     Grid.Column="2" />

            <Button Style="{StaticResource DangerButtonStyle}"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteRecipeCommand}">
                <FontIcon Glyph="&#xE74D;" />
            </Button>

            <TextBlock Text="Ingredients:"
                       Grid.Row="1" />

            <!--  Ingredients List  -->
            <ItemsRepeater x:Name="IngredientsContainer"
                           ItemsSource="{Binding InputEntries}"
                           Grid.ColumnSpan="2"
                           Grid.Row="2">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="30"
                                         HorizontalContentAlignment="Center" />

                                <TextBlock Text="{Binding Item.Name}"
                                           Grid.Column="1"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Rate}"
                                           Grid.Column="2"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />

                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Grid.Column="3"
                                        Command="{Binding ElementName=IngredientsContainer, Path=DataContext.RemoveIngredientCommand}"
                                        CommandParameter="{Binding}">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ComboBox ItemsSource="{Binding AllItems}"
                      SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                      SelectedIndex="0"
                      Grid.Row="3"
                      Margin="0,0,0,0"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Name"
                      IsTextSearchEnabled="True"
                      SelectedValuePath="Content" />

            <Button Content="Add"
                    Grid.Column="1"
                    Grid.Row="3"
                    Command="{Binding AddIngredientCommand}" />

            <TextBlock Text="Results:"
                       Grid.Column="2"
                       Grid.Row="1" />

            <!--  Outputs List  -->
            <ItemsRepeater x:Name="OutputsContainer"
                           ItemsSource="{Binding OutputEntries}"
                           Grid.Column="2"
                           Grid.ColumnSpan="2"
                           Grid.Row="2">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="30"
                                         HorizontalAlignment="Right" />

                                <TextBlock Text="{Binding Item.Name}"
                                           Grid.Column="1"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Rate}"
                                           Grid.Column="2"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />

                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Grid.Column="3"
                                        Command="{Binding ElementName=OutputsContainer, Path=DataContext.RemoveOutputCommand}"
                                        CommandParameter="{Binding}">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <ComboBox ItemsSource="{Binding AllItems}"
                      SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                      SelectedIndex="0"
                      Grid.Column="2"
                      Grid.Row="3"
                      Margin="0,0,0,0"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Name"
                      IsTextSearchEnabled="True"
                      SelectedValuePath="Content" />

            <Button Content="Add"
                    Grid.Column="3"
                    Grid.Row="3"
                    Command="{Binding AddOutputCommand}" />

        </Grid>
    </Border>
</UserControl>
