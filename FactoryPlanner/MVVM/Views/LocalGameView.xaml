<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FactoryPlanner.MVVM.Views.LocalGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FactoryPlanner.MVVM.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             DataContextChanged="OnDataContextChanged"
             mc:Ignorable="d">

    <Border Background="Transparent"
            CornerRadius="8">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <RadioButton IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTipService.ToolTip="Set To Active Game"
                         MinWidth="0"
                         GroupName="ActiveGame" />

            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Enter Game Name..."
                     Grid.Column="1"
                     LostFocus="OnNameBoxLostFocus" />

            <Button ToolTipService.ToolTip="Export"
                    Grid.Column="2"
                    Margin="8,0,0,0">
                <Button.Content>
                    <FontIcon Glyph="&#xE898;" />
                </Button.Content>
            </Button>

            <Button ToolTipService.ToolTip="Delete Game"
                    Style="{StaticResource DangerButtonStyle}"
                    Grid.Column="3"
                    Margin="8,0,0,0">
                <Button.Content>
                    <FontIcon Glyph="&#xE74D;" />
                </Button.Content>
                <Button.Flyout>
                    <Flyout x:Name="ConfirmDeleteFlyout">
                        <Border CornerRadius="8">
                            <Grid ColumnSpacing="8"
                                  RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock>
                                    <TextBlock.Inlines>
                                        <Run Text="Type" />
                                        <Run Text="{Binding DeleteString}" />
                                        <Run Text="to proceed" />
                                    </TextBlock.Inlines>
                                </TextBlock>

                                <TextBox Text="{Binding DeleteConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="1" />

                                <Button ToolTipService.ToolTip="Delete Game"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Command="{Binding DeleteGameCommand}"
                                        IsEnabled="{Binding AllowDelete, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                                    <Button.Content>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </Button.Content>
                                </Button>

                            </Grid>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </Grid>
    </Border>
</UserControl>
