<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FactoryPlanner.MVVM.Views.MachineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:FactoryPlanner.MVVM.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FactoryPlanner.MVVM.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:TrueToVisibleConverter x:Key="trueToVisibleConverter" />
    </UserControl.Resources>
    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <Grid Margin="10"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon Glyph="&#xF8B0;"
                      FontSize="50"
                      Visibility="{Binding UseDefaultIcon, Converter={StaticResource trueToVisibleConverter}}" />

            <Image MinWidth="150"
                   Source="{Binding IconPath}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Left" />

                <TextBlock Text="{Binding PowerCostString}"
                           Grid.Column="1"
                           HorizontalAlignment="Right" />

            </Grid>

        </Grid>
    </Border>
</UserControl>
