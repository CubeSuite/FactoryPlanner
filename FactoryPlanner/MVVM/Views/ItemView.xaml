<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="FactoryPlanner.MVVM.Views.ItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:FactoryPlanner.MVVM.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:FactoryPlanner.MVVM.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:FactoryPlanner.Core.MVVM.Models.ViewModels"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:TrueToVisibleConverter x:Key="trueToVisibleConverter" />
    </UserControl.Resources>
    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <Grid Margin="10"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon Glyph="&#xF8B0;"
                      FontSize="50"
                      Visibility="{Binding UseDefaultIcon, Converter={StaticResource trueToVisibleConverter}}" />

            <Image MinWidth="150"
                   Source="{Binding IconPath}" />

            <TextBlock Text="{Binding Name}"
                       Grid.Row="1"
                       HorizontalAlignment="Center" />

        </Grid>
    </Border>
</UserControl>
