<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="FactoryPlanner.MVVM.Pages.MachinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:FactoryPlanner.MVVM.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="using:FactoryPlanner.Core.MVVM.Models.ViewModels"
      xmlns:views="using:FactoryPlanner.MVVM.Views"
      Margin="8"
      mc:Ignorable="d">

    <Grid ColumnSpacing="8"
          RowSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  Entry GUI  -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondary}"
                CornerRadius="16" />
        <Grid Margin="8"
              ColumnSpacing="8"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Content="Batch Import"
                    Style="{StaticResource AccentButtonStyle}"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    Command="{Binding BatchImportCommand}" />

            <Rectangle Height="1"
                       Grid.Row="1"
                       Fill="Gray" />

            <TextBox Text="{Binding MachineName, Mode=TwoWay}"
                     PlaceholderText="Item Name"
                     Grid.Row="2" />

            <Grid Grid.Row="3"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding IconPath, Mode=TwoWay}"
                         PlaceholderText="Icon Path" />
                <Button Content="Browse"
                        Grid.Column="1"
                        Command="{Binding BrowseForIconCommand}" />
            </Grid>

            <TextBox Text="{Binding PowerCost, Mode=TwoWay}"
                     PlaceholderText="Power Cost (W)"
                     Grid.Row="4" />

            <Button Content="{Binding AddButtonText}"
                    Style="{StaticResource AccentButtonStyle}"
                    Grid.Row="5"
                    HorizontalAlignment="Stretch"
                    Command="{Binding AddMachineCommand}" />

            <Button Content="Delete"
                    Style="{StaticResource DangerButtonStyle}"
                    Grid.Row="6"
                    HorizontalAlignment="Stretch"
                    Command="{Binding DeleteMachineCommand}"
                    Visibility="{Binding DeleteButtonVisibility}" />

            <Grid Grid.Row="8"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Order By:"
                           VerticalAlignment="Center" />

                <ComboBox MinWidth="90"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"
                          SelectedValue="{Binding OrderBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="ID" />
                    <ComboBoxItem Content="Name" />
                </ComboBox>

                <ComboBox MinWidth="125"
                          Grid.Column="2"
                          SelectedIndex="0"
                          SelectedItem="{Binding Direction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Ascending" />
                    <ComboBoxItem Content="Descending" />
                </ComboBox>

            </Grid>


        </Grid>

        <!--  Items  -->

        <ItemsView ItemsSource="{Binding Machines}"
                   Grid.Column="1"
                   SelectionChanged="OnItemsViewSelectionChanged"
                   SelectionMode="Single">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:MachineViewModel">
                    <ItemContainer>
                        <views:MachineView />
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <UniformGridLayout ItemsStretch="Fill"
                                   MinColumnSpacing="8"
                                   MinItemHeight="150"
                                   MinItemWidth="150"
                                   MinRowSpacing="8" />
            </ItemsView.Layout>
        </ItemsView>

    </Grid>
</Page>
