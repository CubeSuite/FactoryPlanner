<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FactoryPlanner.Core\FactoryPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="testconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="testconfig.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ArchiveServiceTests.cs" />
    <Compile Include="BackupServiceTests.cs" />
    <Compile Include="EncryptionServiceTests.cs" />
    <Compile Include="FileUtilsTests.cs" />
    <Compile Include="HttpServiceTests.cs" />
    <Compile Include="LoggerServiceTests.cs" />
    <Compile Include="NavigationServiceTests.cs" />
    <Compile Include="NotificationServiceTests.cs" />
    <Compile Include="ObjectStoreTests.cs" />
    <Compile Include="SearchServiceTests.cs" />
    <Compile Include="TestConfig.cs" />
    <Compile Include="TestUtils.cs" />
    <Compile Include="ThemeServiceTests.cs" />
    <Compile Include="UserSettingsTests.cs" />
  </ItemGroup>
</Project>
